{
  "question_type": "single_choice",
  "stem_md": "以下命题中错误的是。",
  "options_json": [
    {
      "key": "opt_1",
      "content_md": "$\\xi\\sim P(\\lambda)$则$E(\\xi^2)=2\\lambda^2$"
    },
    {
      "key": "opt_2",
      "content_md": "$\\xi\\sim N(0,1)$则$E(\\xi^2)=1$"
    },
    {
      "key": "opt_3",
      "content_md": "$\\xi\\sim B(1,p)$则$E(\\xi^2)=p$"
    },
    {
      "key": "opt_4",
      "content_md": "$\\xi\\sim U[a,b]$则$E(\\xi^2)=(a^2+ab+b^2)/3$"
