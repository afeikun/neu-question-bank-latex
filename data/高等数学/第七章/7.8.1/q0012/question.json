  "stem_md": "函数 $f(x,y)=\\ln(1+x^2+y^2)+1-\\frac{x^3}{15}-\\frac{y^2}{4}$ 的极值为。",
  "options_json": [
    {
      "key": "opt_1",
      "content_md": "最大值 $\\ln5+\\frac7{15}$，极小值1"
