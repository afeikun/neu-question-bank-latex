{
  "question_type": "single_choice",
  "stem_md": "曲线 $x^2+y^2=5,z=x^2-y^2$ 在点 $(1,2,-3)$ 处的切线方程是。",
  "options_json": [
    {
      "key": "opt_1",
      "content_md": "$\\frac{x-1}{2}=\\frac{y-2}{-1}=\\frac{z+3}{-8}$"
