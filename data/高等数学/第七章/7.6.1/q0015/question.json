  "stem_md": "曲线 $y^2=2mx,z^2=m-x$ 在 $(x_0,y_0,z_0)$ 处的切线方程为。",
  "options_json": [
    {
      "key": "opt_1",
      "content_md": "$\\frac{x-x_0}{0}=\\frac{y-y_0}{m/y_0}=\\frac{z-z_0}{1/z_0}$"
