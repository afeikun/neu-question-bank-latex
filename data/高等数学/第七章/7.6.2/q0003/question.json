{
  "question_type": "single_choice",
  "stem_md": "曲面 $z=f(x,y)$ 过点 $P(2,1,-3)$，且其上任一点满足 $yf_x+zf_y=f$，$f_y(2,1)=2$，求 $P$ 处切平面方程。",
  "options_json": [
    {
      "key": "opt_1",
      "content_md": "$2x+3y-z=11$"
