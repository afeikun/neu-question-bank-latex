{
  "question_type": "single_choice",
  "stem_md": "曲面 $z=2x^2+3y^2$ 在点 $(1,2,14)$ 处的切平面方程为。",
  "options_json": [
    {
      "key": "opt_1",
      "content_md": "$4x+12y+z=14$"
