  "question_type": "single_choice",
  "stem_md": "以点 $O(1,-2,2)$ 为球心，且通过坐标原点的球面方程为(\\quad)。",
  "options_json": [
    {
      "key": "opt_1",
      "content_md": "$x^2+y^2+z^2-2x+4y-4z+3=0$"
    },
