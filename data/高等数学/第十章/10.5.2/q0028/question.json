  "question_type": "single_choice",
  "stem_md": "$y^3y\\prime\\prime+1=0,\\ y(1)=1,\\ y\\prime(1)=0$ 的解为（ ）",
  "options_json": [
    {
      "key": "opt_1",
      "content_md": "$y\\prime^2=\\frac1{y^2}+C_1$"
    },
