{
  "question_type": "single_choice",
  "stem_md": "求曲线 $y=x^2$ 与 $y=x^3$ 所围图形的面积，正确的是",
  "options_json": [
    {
      "key": "opt_1",
      "content_md": "$S=\\int_0^1(x^3-x^2)\\,dx$"
    },
    {
