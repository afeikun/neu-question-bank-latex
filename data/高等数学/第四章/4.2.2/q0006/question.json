      "content_md": "$S=\\int_0^1(y-\\sqrt y)\\,dy$"
    },
    {
      "key": "opt_3",
      "content_md": "$S=\\int_0^1(y^2-y)\\,dy$"
    },
    {
      "key": "opt_4",
      "content_md": "$S=\\int_0^1(x^2-x^3)\\,dx$"
    }
  ],
  "answer_json": {
