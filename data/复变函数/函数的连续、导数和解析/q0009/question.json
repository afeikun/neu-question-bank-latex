  "stem_md": "复数 $f(z)=u(x,y)+iv(x,y)$ 在点 $z_0=x_0+iy_0$ 处连续的充要条件是（ ）。",
  "options_json": [
    {
      "key": "opt_1",
      "content_md": "$u(x,y)$ 和 $v(x,y)$ 在 $(x_0,y_0)$ 处连续"
