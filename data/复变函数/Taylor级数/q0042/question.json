{
  "question_type": "single_choice",
  "stem_md": "函数 $e^{2z}\\cos(iz)$ 在 $z=0$ 处的泰勒级数展开式是____。",
  "options_json": [
    {
      "key": "opt_1",
      "content_md": "$\\sum_{n=0}^{\\infty}(1+3^n)z^n/(2n!),\\ |z|<\\infty$"
    },
    {
      "key": "opt_2",
      "content_md": "$\\sum_{n=0}^{\\infty}(1-3^n)z^n/(2n!),\\ |z|<\\infty$"
    },
    {
      "key": "opt_3",
      "content_md": "$\\sum_{n=0}^{\\infty}(1+2^n)z^n/n!$"
    },
    {
      "key": "opt_4",
      "content_md": "$\\sum_{n=0}^{\\infty}(1-2^n)z^n/n!$"
    }
  ],
  "answer_json": {
    "option_keys": [
      "opt_1"
    ]
  },
  "analysis_md": "$e^{2z}\\cos(iz)=(e^z+e^{3z})/2$，故系数为 $(1+3^n)/(2n!)$。",
  "search_text": "函数 $e^{2z}\\cos(iz)$ 在 $z=0$ 处的泰勒级数展开式是____。 $\\sum_{n=0}^{\\infty}(1+3^n)z^n/(2n!),\\ |z|<\\infty$ $\\sum_{n=0}^{\\infty}(1-3^n)z^n/(2n!),\\ |z|<\\infty$ $\\sum_{n=0}^{\\infty}(1+2^n)z^n/n!$ $\\sum_{n=0}^{\\infty}(1-2^n)z^n/n!$ $e^{2z}\\cos(iz)=(e^z+e^{3z})/2$，故系数为 $(1+3^n)/(2n!)$。",
  "sort_order": 42
}