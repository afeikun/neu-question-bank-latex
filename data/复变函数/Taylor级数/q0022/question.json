  "stem_md": "函数 $1/(z-a)^2$（$a\\ne0$）的 Taylor 展开式是（ ）",
  "options_json": [
    {
      "key": "opt_1",
      "content_md": "$\\sum_{n=1}^{\\infty}\\frac{n}{a^{n+1}}z^{n-1},\\ |z|<a$"
