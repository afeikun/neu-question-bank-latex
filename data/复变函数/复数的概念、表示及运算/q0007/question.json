  "question_type": "single_choice",
  "stem_md": "设 $z=x+iy$，则 $\\dfrac{z-1}{z+1}$ 的实部和虚部是（ ）。",
  "options_json": [
    {
      "key": "opt_1",
      "content_md": "$\\dfrac{x^2+y^2-1}{(x+1)^2+y^2},\\ \\dfrac{2y}{(x+1)^2+y^2}$"
    },
    {
      "key": "opt_2",
      "content_md": "$\\dfrac{x^2-y^2-1}{(x+1)^2+y^2},\\ \\dfrac{2y}{(x+1)^2+y^2}$"
    },
    {
      "key": "opt_3",
      "content_md": "$\\dfrac{x^2+y^2-1}{(x+1)^2+y^2},\\ -\\dfrac{2y}{(x+1)^2+y^2}$"
    },
    {
      "key": "opt_4",
      "content_md": "$\\dfrac{x^2-y^2+1}{(x+1)^2+y^2},\\ \\dfrac{2y}{(x+1)^2+y^2}$"
