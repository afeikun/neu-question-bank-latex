{
  "question_type": "single_choice",
  "stem_md": "$\\oint_{|z-2|=3}\\frac{e^z}{z^2-2z}\\,dz=(\\quad)$（方向为正向）。",
  "options_json": [
    {
      "key": "opt_1",
      "content_md": "$(e^2-1)\\pi i$"
    },
    {
      "key": "opt_2",
      "content_md": "$\\frac{e^2-1}{2}$"
    },
    {
